crude_counts_display <- exposure_level_counts %>%
group_by(
exposure_family,
exposure
) %>%
mutate(
total_cases = sum(outcome_1, na.rm = TRUE),
total_non_cases = sum(outcome_0, na.rm = TRUE),
`Cases (%)` = if_else(
total_cases > 0,
sprintf(
"%d (%.1f%%)",
outcome_1,
100 * outcome_1 / total_cases
),
""
),
`Non-cases (%)` = if_else(
total_non_cases > 0,
sprintf(
"%d (%.1f%%)",
outcome_0,
100 * outcome_0 / total_non_cases
),
""
),
Category = case_when(
exposure_level == "no_med_use_recorded" ~
"No medication use recorded",
exposure_level ==
"no_medication_records_for_this_time_period" ~
"No medication records for this time period",
TRUE ~ as.character(exposure_level)
)
) %>%
ungroup() %>%
dplyr::select(
exposure_family,
exposure,
Category,
`Cases (%)`,
`Non-cases (%)`
)
