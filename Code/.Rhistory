mutate(
`Crude OR (95% CI)` = case_when(
is_reference ~ "1.000 (reference)",
TRUE ~ `Crude OR (95% CI)`
),
`Wald p-value` = case_when(
is_reference ~ "",
TRUE ~ `Wald p-value`
)
)
library(dplyr)
library(stringr)
library(purrr)
library(tibble)
#===============================================================================
# Formatting functions
#===============================================================================
format_p <- function(x, digits = 3) {
dplyr::case_when(
is.na(x)  ~ "",
x < 0.001 ~ "<0.001",
TRUE ~ formatC(
x,
format = "f",
digits = digits
)
)
}
format_count_percent <- function(count, denominator, digits = 1) {
dplyr::case_when(
is.na(count) |
is.na(denominator) |
denominator == 0 ~ "",
TRUE ~ sprintf(
paste0("%d (%.", digits, "f%%)"),
as.integer(count),
100 * count / denominator
)
)
}
# Apply identical cleaning to:
# 1. coefficient categories
# 2. count-table categories
# 3. reference categories
pretty_category <- function(x) {
x <- as.character(x)
dplyr::case_when(
is.na(x) ~ NA_character_,
x == "" |
x == "continuous" ~
"Continuous",
x == "no_med_use_recorded" ~
"No medication use recorded",
x == "no_medication_records_for_this_time_period" ~
"No medication records for this time period",
TRUE ~ x
)
}
crude_model_display <- crude_results %>%
dplyr::mutate(
exposure = as.character(exposure),
term = as.character(term),
# For continuous variables, term usually equals exposure.
# For factors, remove the exposure name from the start of term.
Category_raw = dplyr::case_when(
term == exposure ~ "continuous",
stringr::str_starts(term, exposure) ~
stringr::str_sub(
term,
start = stringr::str_length(exposure) + 1L
),
TRUE ~ term
),
Category = pretty_category(Category_raw),
`Crude OR (95% CI)` = dplyr::case_when(
is.na(OR) |
is.na(CI_lower) |
is.na(CI_upper) ~ "",
TRUE ~ sprintf(
"%.3f (%.3f–%.3f)",
OR,
CI_lower,
CI_upper
)
),
`Wald p-value` = format_p(wald_p)
) %>%
dplyr::select(
exposure_family,
exposure,
Category,
`Crude OR (95% CI)`,
`Wald p-value`
)
reference_lookup <- crude_results %>%
dplyr::filter(
!is.na(reference_level),
reference_level != ""
) %>%
dplyr::transmute(
exposure_family,
exposure,
ReferenceCategory = pretty_category(reference_level)
) %>%
dplyr::distinct()
reference_lookup %>%
dplyr::count(
exposure_family,
exposure
) %>%
dplyr::filter(n > 1)
crude_overall_p <- crude_results %>%
dplyr::group_by(
exposure_family,
exposure
) %>%
dplyr::summarise(
`LRT p-value` = format_p(
dplyr::first(
overall_LRT_p[!is.na(overall_LRT_p)],
default = NA_real_
)
),
`Family FDR p-value` = format_p(
dplyr::first(
LRT_p_FDR_within_family[
!is.na(LRT_p_FDR_within_family)
],
default = NA_real_
)
),
`Global FDR p-value` = format_p(
dplyr::first(
LRT_p_FDR_global[
!is.na(LRT_p_FDR_global)
],
default = NA_real_
)
),
.groups = "drop"
)
crude_counts_display <- exposure_level_counts %>%
dplyr::group_by(
exposure_family,
exposure
) %>%
dplyr::mutate(
category_original_order = dplyr::row_number(),
total_cases = sum(
outcome_1,
na.rm = TRUE
),
total_non_cases = sum(
outcome_0,
na.rm = TRUE
),
`Cases (%)` = format_count_percent(
outcome_1,
total_cases
),
`Non-cases (%)` = format_count_percent(
outcome_0,
total_non_cases
),
Category = pretty_category(exposure_level)
) %>%
dplyr::ungroup() %>%
dplyr::select(
exposure_family,
exposure,
Category,
category_original_order,
`Cases (%)`,
`Non-cases (%)`
)
family_order_lookup <- tibble::tibble(
exposure_family = names(exposure_families),
family_order = seq_along(exposure_families)
)
exposure_order_lookup <- purrr::imap_dfr(
exposure_families,
function(variables, family_name) {
tibble::tibble(
exposure_family = family_name,
exposure = variables,
exposure_order = seq_along(variables)
)
}
) %>%
dplyr::distinct(
exposure_family,
exposure,
.keep_all = TRUE
)
crude_results_table <- crude_counts_display %>%
# Add the reference category to every row for each exposure
dplyr::left_join(
reference_lookup,
by = c(
"exposure_family",
"exposure"
)
) %>%
# Add OR and Wald p-value to the relevant non-reference rows
dplyr::left_join(
crude_model_display,
by = c(
"exposure_family",
"exposure",
"Category"
)
) %>%
# Add the overall LRT and FDR p-values
dplyr::left_join(
crude_overall_p,
by = c(
"exposure_family",
"exposure"
)
) %>%
# Add the desired family and exposure order
dplyr::left_join(
family_order_lookup,
by = "exposure_family"
) %>%
dplyr::left_join(
exposure_order_lookup,
by = c(
"exposure_family",
"exposure"
)
) %>%
dplyr::mutate(
is_reference =
!is.na(ReferenceCategory) &
Category == ReferenceCategory,
# Put the reference category first
reference_order = dplyr::if_else(
is_reference,
0L,
1L
),
# Add the reference OR manually
`Crude OR (95% CI)` = dplyr::case_when(
is_reference ~ "1.000 (reference)",
TRUE ~ dplyr::coalesce(
`Crude OR (95% CI)`,
""
)
),
# Reference categories have no coefficient-level Wald p-value
`Wald p-value` = dplyr::case_when(
is_reference ~ "",
TRUE ~ dplyr::coalesce(
`Wald p-value`,
""
)
),
# Put unrecognised families/exposures at the end
family_order = dplyr::coalesce(
family_order,
length(exposure_families) + 1L
),
exposure_order = dplyr::coalesce(
exposure_order,
999999L
)
) %>%
dplyr::arrange(
family_order,
exposure_order,
reference_order,
category_original_order
)
crude_results_table <- crude_results_table %>%
dplyr::group_by(
exposure_family,
exposure
) %>%
dplyr::mutate(
`LRT p-value` = dplyr::if_else(
dplyr::row_number() == 1L,
`LRT p-value`,
""
),
`Family FDR p-value` = dplyr::if_else(
dplyr::row_number() == 1L,
`Family FDR p-value`,
""
),
`Global FDR p-value` = dplyr::if_else(
dplyr::row_number() == 1L,
`Global FDR p-value`,
""
)
) %>%
dplyr::ungroup()
View(crude_results_table)
crude_results_table2 <- crude_results_table %>%
dplyr::transmute(
Group = exposure_family,
Variable = exposure,
Category,
`Cases (%)`,
`Non-cases (%)`,
`Crude OR (95% CI)`,
`Wald p-value`,
`LRT p-value`,
`Family FDR p-value`,
`Global FDR p-value`
)
View(crude_results_table2)
crude_results_table3 <- crude_results_table2 %>%
dplyr::mutate(
Group_original = Group,
Variable_original = Variable
) %>%
# Display each variable name only once
dplyr::group_by(
Group_original,
Variable_original
) %>%
dplyr::mutate(
Variable = dplyr::if_else(
dplyr::row_number() == 1L,
Variable,
""
)
) %>%
dplyr::ungroup() %>%
# Display each exposure family only once
dplyr::group_by(Group_original) %>%
dplyr::mutate(
Group = dplyr::if_else(
dplyr::row_number() == 1L,
Group,
""
)
) %>%
dplyr::ungroup() %>%
dplyr::select(
-Group_original,
-Variable_original
)
View(crude_results_table3)
install.packages(c("writexl", "readr", "officer", "flextable"))
