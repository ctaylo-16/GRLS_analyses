100 * count / denominator
)
)
}
### mode results
crude_model_display <- crude_results %>%
mutate(
Category = str_remove(
term,
paste0("^", stringr::str_escape(exposure))
),
Category = case_when(
Category == "no_med_use_recorded" ~ "No medication use recorded",
TRUE ~ Category
),
`Crude OR (95% CI)` = sprintf(
"%.3f (%.3f–%.3f)",
OR,
CI_lower,
CI_upper
),
`Wald p-value` = format_p(wald_p),
`LRT p-value` = format_p(overall_LRT_p),
`Family FDR p-value` =
format_p(LRT_p_FDR_within_family),
`Global FDR p-value` =
format_p(LRT_p_FDR_global)
) %>%
dplyr::select(
exposure_family,
exposure,
Category,
reference_level,
`Crude OR (95% CI)`,
`Wald p-value`,
`LRT p-value`,
`Family FDR p-value`,
`Global FDR p-value`
)
#counts
